{
  "name": "opencode-sidebar-modern-gitstats",
  "version": "1.0.0",
  "description": "OpenCode v2 TUI sidebar plugin for real-time Git branch status, modified files tracking, and interactive branch checkout.",
  "type": "module",
  "main": "./tui.ts",
  "module": "./tui.ts",
  "exports": {
    ".": "./tui.ts",
    "./tui": "./tui.ts"
  },
  "files": [
    "dist/",
    "tui.js",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-jsx.mjs",
    "build:jsx": "node scripts/build-jsx.mjs",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node scripts/build-jsx.mjs\"",
    "test": "bun test/test.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "update": "git pull && bun run check && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opentui",
    "tui",
    "git",
    "git-status",
    "branch"
  ],
  "author": "Gamflaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MomoPi-Dark/opencode.sidebar.modern.gitstats"
  },
  "dependencies": {
    "@opencode/client": "2.0.27",
    "@opencode/plugin": "2.0.27",
    "@opencode/theme": "2.0.27",
    "@opentui/core": "0.6.2",
    "@opentui/solid": "0.5.17",
    "effect": "^3.22.2",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsc-watch": "^7.2.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.17"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "private": true
}
